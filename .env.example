# =================================================================
# Uptime Monitoring Stack Configuration (.env)
# Copy this file to .env to customize deployment settings
# =================================================================

# Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Frontend URL (Used for CORS validation)
FRONTEND_URL=http://localhost

# Security Secret (Change this to a long, random string in production)
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uptime_db

# Email Notifications (Optional - configure if email alerts are needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Monitoring Defaults
DEFAULT_CHECK_INTERVAL=60
CHECK_TIMEOUT=10
